  m_Name: mission_delivery_basic_01
  m_EditorClassIdentifier: Data::DeliveryMissionTemplateConfig
  id: mission_delivery_basic_01
  displayName: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0442\u043E\u0432\u0430\u0440\u0430"
  description: "\u041F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0430 \u043F\u0430\u0440\u0442\u0438\u0438
    \u0442\u043E\u0432\u0430\u0440\u0430 \u043C\u0435\u0436\u0434\u0443 \u043F\u043B\u0430\u043D\u0435\u0442\u0430\u043C\u0438."
  icon: {fileID: 21300000, guid: f9fc68f840683439e99838efabb854fe, type: 3}
  titlePattern: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430: {targetSystem}
    -> {targetPlanet}"
  descriptionPattern: "\u0414\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0433\u0440\u0443\u0437
    \xAB{itemName}\xBB \u0432 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    {amount} \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0443 {targetPlanet}
    \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0435 {targetSystem}. \u041E\u0431\u044A\u0451\u043C
    \u0433\u0440\u0443\u0437\u0430: {cargoVolume}. \u0421\u0434\u0430\u0439\u0442\u0435
    \u0433\u0440\u0443\u0437 \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0435
    \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F, \u0447\u0442\u043E\u0431\u044B
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443.
    \u041F\u0440\u0438 \u043F\u043E\u0442\u0435\u0440\u0435 \u0433\u0440\u0443\u0437\u0430
    \u0438\u043B\u0438 \u0437\u0430\u0445\u0432\u0430\u0442\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0432\u0440\u0430\u0433\u043E\u043C
    \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0442\u0441\u044F."
  outcomeTexts:
    ReadyToTurnIn: "\u0412\u044B \u043F\u0440\u0438\u0431\u044B\u043B\u0438 \u043D\u0430
      \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F.
      \u0421\u0434\u0430\u0439\u0442\u0435 \u0433\u0440\u0443\u0437 \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      \u043D\u0430\u0433\u0440\u0430\u0434\u0443."
    Completed: "\u0413\u0440\u0443\u0437 \u043F\u0435\u0440\u0435\u0434\u0430\u043D
      \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044E. \u041D\u0430\u0433\u0440\u0430\u0434\u0430
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430."
    Failed: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0435\u043D\u0430.
      \u041D\u0430\u0433\u0440\u0430\u0434\u0430 \u043D\u0435 \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    Expired: "\u0421\u0440\u043E\u043A \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438
      \u0438\u0441\u0442\u0451\u043A. \u041D\u0430\u0433\u0440\u0430\u0434\u0430
      \u043D\u0435 \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    Cancelled: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u043E\u0442\u043C\u0435\u043D\u0435\u043D\u0430.
      \u041D\u0430\u0433\u0440\u0430\u0434\u0430 \u043D\u0435 \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    MissionCargoLost: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0435\u043D\u0430:
      \u0433\u0440\u0443\u0437 \u043F\u043E\u0442\u0435\u0440\u044F\u043D. \u041D\u0430\u0433\u0440\u0430\u0434\u0430
      \u043D\u0435 \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    SystemCaptured: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0435\u043D\u0430:
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 {targetSystem} \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D\u0430
      \u0432\u0440\u0430\u0433\u043E\u043C. \u041D\u0430\u0433\u0440\u0430\u0434\u0430
      \u043D\u0435 \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
