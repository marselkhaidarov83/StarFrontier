  displayName: "\u0417\u0430\u0432\u043E\u0434\u044B \u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439
    \u0422\u044C\u043C\u044B"
  description: "\u0426\u0435\u0445\u0430 \u0441\u0432\u044F\u0437\u0430\u043D\u044B
    \u0433\u0440\u0443\u0437\u043E\u0432\u044B\u043C\u0438 \u043B\u0438\u043D\u0438\u044F\u043C\u0438:
    \u0443\u0442\u0440\u043E\u043C \u043F\u043E \u043D\u0438\u043C \u0438\u0434\u0451\u0442
    \u0441\u044B\u0440\u044C\u0451, \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u2014
    \u0433\u043E\u0442\u043E\u0432\u044B\u0435 \u0434\u0435\u0442\u0430\u043B\u0438.
    \u041C\u0435\u0441\u0442\u043D\u044B\u0435 \u0440\u0430\u0431\u043E\u0447\u0438\u0435
    \u0443\u0437\u043D\u0430\u044E\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0439
    \u0446\u0435\u0445 \u043F\u043E \u0442\u043E\u043D\u0443, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u0432\u0438\u0431\u0440\u0438\u0440\u0443\u044E\u0442 \u043E\u043F\u043E\u0440\u044B
    \u044D\u0441\u0442\u0430\u043A\u0430\u0434."
