  displayName: "\u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u0438\u0439
    \u041A\u0443\u043F\u043E\u043B"
  description: "\u0417\u0430 \u0436\u0438\u043B\u044B\u043C\u0438
    \u043A\u0443\u043F\u043E\u043B\u0430\u043C\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E\u043B\u0438\u0433\u043E\u043D\u044B, \u0433\u0434\u0435 \u043F\u0440\u0438\u0431\u043E\u0440\u044B
    \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u044E\u0442 \u0432\u0434\u0430\u043B\u0438 \u043E\u0442
    \u043F\u043E\u0440\u0442\u043E\u0432\u044B\u0445 \u043F\u043E\u043C\u0435\u0445. \u041C\u0435\u0436\u0434\u0443
    \u043A\u043E\u0440\u043F\u0443\u0441\u0430\u043C\u0438 \u043F\u043E\u0440\u043E\u0439
    \u043C\u043E\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C
    \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u043F\u0440\u0438\u0431\u043E\u0440\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0435\u0449\u0451 \u043D\u0435 \u0434\u0430\u043B\u0438
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F."
