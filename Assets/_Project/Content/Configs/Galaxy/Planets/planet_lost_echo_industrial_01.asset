  displayName: "\u0420\u0436\u0430\u0432\u044B\u0439 \u041F\u0435\u0440\u0435\u0434\u0430\u0442\u0447\u0438\u043A"
  description: "\u041D\u0430
    \u043E\u043A\u0440\u0430\u0438\u043D\u0435
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u0440\u0430\u0439\u043E\u043D\u043E\u0432 \u0435\u0449\u0451
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u043F\u0435\u0440\u0432\u044B\u0435
    \u0446\u0435\u0445\u0430 \u0441 \u0440\u0443\u0447\u043D\u044B\u043C\u0438
    \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u044B\u043C\u0438 \u043A\u0440\u0430\u043D\u0430\u043C\u0438.
    \u0420\u0430\u0431\u043E\u0447\u0438\u0435 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F
    \u0441\u043C\u0435\u043D\u0438\u043B\u0438\u0441\u044C, \u0430 \u0441\u0442\u0430\u0440\u044B\u0435
    \u0437\u0430\u0432\u043E\u0434\u0441\u043A\u0438\u0435 \u0433\u0443\u0434\u043A\u0438
    \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u0441\u043B\u044B\u0448\u043D\u044B \u0432
    \u043A\u043E\u043D\u0446\u0435 \u0441\u043C\u0435\u043D\u044B."
