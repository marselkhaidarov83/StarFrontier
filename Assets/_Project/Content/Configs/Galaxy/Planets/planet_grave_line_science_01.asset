    \u0441\u0434\u0435\u043B\u0430\u043D\u044B \u0435\u0449\u0451 \u0434\u043E
    \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0439 \u0431\u0430\u0437\u044B.
    \u041F\u0435\u0440\u0432\u044B\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F
