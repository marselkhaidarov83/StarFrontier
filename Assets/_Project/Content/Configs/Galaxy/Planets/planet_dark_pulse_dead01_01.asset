  displayName: "\u0417\u0430\u0442\u0443\u0445\u0448\u0438\u0439 \u0423\u0434\u0430\u0440"
  description: "\u0423
    \u044D\u0442\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u044B \u043D\u0435\u0442
    \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E\u0439 \u0440\u043E\u0441\u0441\u044B\u043F\u0438
    \u043D\u043E\u0447\u043D\u044B\u0445 \u043E\u0433\u043D\u0435\u0439. \u0412 \u044F\u0441\u043D\u043E\u043C
    \u0440\u0430\u043A\u0443\u0440\u0441\u0435 \u0432\u0438\u0434\u043D\u044B \u0446\u0435\u043B\u044B\u0435
    \u0446\u0435\u043F\u043E\u0447\u043A\u0438 \u0432\u043F\u0430\u0434\u0438\u043D. \u0414\u0430\u0436\u0435
    \u0441\u0430\u043C\u044B\u0435 \u0447\u0451\u0442\u043A\u0438\u0435 \u0441\u043D\u0438\u043C\u043A\u0438
    \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435
    \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u0438, \u043A\u0430\u043A\u043E\u0439
    \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0440\u044F\u0434\u043E\u043C \u0441
    \u043E\u0431\u0436\u0438\u0442\u044B\u043C\u0438 \u043C\u0438\u0440\u0430\u043C\u0438."
