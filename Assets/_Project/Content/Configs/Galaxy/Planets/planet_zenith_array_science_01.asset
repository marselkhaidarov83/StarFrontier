    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u043C\u0443
    \u043A\u043E\u0440\u043F\u0443\u0441\u0443. \u041D\u0430 \u0441\u0442\u0430\u0440\u044B\u0445
    \u0432\u044B\u0448\u043A\u0430\u0445 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440
    \u0432\u0438\u0441\u044F\u0442 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0435
    \u0442\u0430\u0431\u043B\u0438\u0446\u044B, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u043C
