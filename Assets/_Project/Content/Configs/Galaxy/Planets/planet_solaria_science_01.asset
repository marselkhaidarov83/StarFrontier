  displayName: "\u041E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u044F
    \u041F\u043B\u0430\u043C\u0435\u043D\u0438"
  description: "\u041C\u0435\u0441\u0442\u043D\u044B\u0435
    \u044D\u043A\u0438\u043F\u0430\u0436\u0438 \u043E\u0431\u044B\u0447\u043D\u043E \u0432\u0435\u0437\u0443\u0442
    \u0441\u044E\u0434\u0430 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u044B \u0441
    \u043E\u0431\u0440\u0430\u0437\u0446\u0430\u043C\u0438 \u0438
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435,
    \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0435
    \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435 \u043B\u044E\u0431\u043E\u0433\u043E
    \u0433\u0440\u0443\u0437\u0430. \u0417\u0434\u0435\u0448\u043D\u0438\u0435 \u0436\u0438\u043B\u044B\u0435
    \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u044B
    \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0438 \u0442\u0430\u043A,
    \u0447\u0442\u043E\u0431\u044B \u0438\u0445 \u0441\u0432\u0435\u0442 \u043D\u0435
    \u043F\u043E\u043F\u0430\u0434\u0430\u043B \u0432 \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u044B
    \u043E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u0439."
