    \u0425\u043E\u0440\u043E\u0448\u043E \u0432\u0438\u0434\u043D\u044B \u043B\u0438\u0448\u044C
    \u0433\u0440\u0435\u0431\u043D\u0438, \u043E\u0431\u0440\u0430\u0449\u0451\u043D\u043D\u044B\u0435 \u043A
    \u0437\u0432\u0435\u0437\u0434\u0435. \u0421 \u043A\u0430\u0436\u0434\u044B\u043C
    \u0432\u0438\u0442\u043A\u043E\u043C \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0440\u0438\u0441\u0443\u043D\u043E\u043A \u0442\u0435\u043D\u0435\u0439, \u0438 \u043E\u0434\u043D\u0438
