  displayName: "\u0414\u043E\u043C \u0422\u0438\u0445\u043E\u0433\u043E \u0421\u043B\u0435\u0434\u0430"
  description: "\u0412 \u0433\u0440\u0443\u0437\u043E\u0432\u044B\u0445
    \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u0430\u0445 \u043F\u0443\u0442\u044C
    \u043C\u0435\u0436\u0434\u0443 \u0441\u0435\u043A\u0442\u043E\u0440\u0430\u043C\u0438
    \u043C\u0435\u0440\u044F\u044E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0434\u043E
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0432\u044B\u043B\u0435\u0442\u0430.
    \u0412\u043D\u0438\u0437\u0443, \u043F\u043E\u0434 \u0448\u0443\u043C\u043E\u043C
    \u043F\u043E\u0440\u0442\u043E\u0432\u044B\u0445 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u0432,
    \u0441\u043B\u044B\u0448\u043D\u0430 \u0440\u0435\u0447\u044C \u044D\u043A\u0438\u043F\u0430\u0436\u0435\u0439
    \u0441 \u0434\u0435\u0441\u044F\u0442\u043A\u043E\u0432
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u0432."
