  displayName: "\u041E\u0440\u0443\u0434\u0438\u0439\u043D\u044B\u0435 \u0417\u0430\u0432\u043E\u0434\u044B"
  description: "\u0417\u0430\u0432\u043E\u0434\u0441\u043A\u0438\u0435
    \u0440\u0430\u0439\u043E\u043D\u044B \u0432\u044B\u0440\u043E\u0441\u043B\u0438
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0434\u043E\u043A\u043E\u0432,
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0445 \u043F\u0440\u0438\u043D\u044F\u0442\u044C
    \u043A\u043E\u0440\u0430\u0431\u0435\u043B\u044C\u043D\u044B\u0435 \u0441\u0435\u043A\u0446\u0438\u0438
    \u0446\u0435\u043B\u0438\u043A\u043E\u043C. \u0421 \u0434\u0430\u043B\u044C\u043D\u0438\u0445
    \u043F\u0440\u0438\u0447\u0430\u043B\u043E\u0432 \u043F\u043B\u0430\u043D\u0435\u0442\u0430
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u0438\u0437
    \u043F\u0440\u044F\u043C\u044B\u0445 \u043B\u0438\u043D\u0438\u0439, \u0441\u0432\u0435\u0442\u0430 \u0438
    \u0434\u0432\u0438\u0436\u0443\u0449\u0435\u0433\u043E\u0441\u044F \u043C\u0435\u0442\u0430\u043B\u043B\u0430."
