    \u0432\u0435\u0440\u0435\u043D\u0438\u0446\u0430 \u043E\u0433\u043D\u0435\u0439:
    \u0433\u0440\u0443\u0437\u043E\u0432\u044B\u0435 \u0441\u0443\u0434\u0430
    \u0437\u0430\u0445\u043E\u0434\u044F\u0442 \u043D\u0430 \u043F\u043E\u0441\u0430\u0434\u043A\u0443
    \u043E\u0434\u043D\u043E \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C.
    \u0421\u0442\u0430\u0440\u044B\u0435 \u043F\u0440\u0438\u0447\u0430\u043B\u044B \u0435\u0449\u0451
    \u043F\u043E\u043C\u043D\u044F\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0430, \u043A\u043E\u0433\u0434\u0430
    \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0430\u043B\u044C\u043D\u0438\u0439 \u0440\u0435\u0439\u0441
    \u0431\u044B\u043B \u0441\u043E\u0431\u044B\u0442\u0438\u0435\u043C."
