  id: planet_black_star_science_01
  displayName: "\u041E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u044F
    \u0427\u0451\u0440\u043D\u043E\u0433\u043E \u0421\u0432\u0435\u0442\u0430"
  description: "\u041C\u0435\u0441\u0442\u043D\u044B\u0435 \u044D\u043A\u0438\u043F\u0430\u0436\u0438
    \u043E\u0431\u044B\u0447\u043D\u043E \u0432\u0435\u0437\u0443\u0442 \u0441\u044E\u0434\u0430
    \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u044B \u0441
    \u043E\u0431\u0440\u0430\u0437\u0446\u0430\u043C\u0438 \u0438
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435,
    \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0435
    \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435 \u043B\u044E\u0431\u043E\u0433\u043E
    \u0433\u0440\u0443\u0437\u0430. \u041D\u0430 \u0441\u0442\u0430\u0440\u044B\u0445
    \u0432\u044B\u0448\u043A\u0430\u0445 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440
    \u0432\u0438\u0441\u044F\u0442 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0435
    \u0442\u0430\u0431\u043B\u0438\u0446\u044B, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0438 \u043F\u0435\u0440\u0432\u044B\u0435
    \u0430\u043D\u0442\u0435\u043D\u043D\u044B."
