    \u0434\u0440\u0435\u0432\u043D\u0438\u0445 \u043A\u0440\u0430\u0442\u0435\u0440\u043E\u0432,
    \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043C\u044B\u0435 \u0434\u0430\u0436\u0435 \u0432
    \u0441\u043B\u0430\u0431\u043E\u043C \u0441\u0432\u0435\u0442\u0435. \u0417\u0434\u0435\u0441\u044C
    \u043B\u0435\u0433\u043A\u043E \u043E\u0448\u0438\u0431\u0438\u0442\u044C\u0441\u044F \u0432
    \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0435: \u043E\u0442\u043C\u0435\u0442\u0438\u043D\u0430 \u043D\u0430
