  description: "\u0421 \u043E\u0440\u0431\u0438\u0442\u044B
    \u043A\u0430\u0440\u044C\u0435\u0440\u043D\u044B\u0435 \u0443\u0441\u0442\u0443\u043F\u044B
    \u043F\u043E\u0445\u043E\u0436\u0438 \u043D\u0430 \u0433\u043E\u0434\u043E\u0432\u044B\u0435
    \u043A\u043E\u043B\u044C\u0446\u0430, \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0435 \u0432
    \u043A\u043E\u0440\u0435 \u043F\u043B\u0430\u043D\u0435\u0442\u044B. \u041F\u0435\u0440\u0432\u044B\u0435
    \u0448\u0430\u0445\u0442\u0451\u0440\u0441\u043A\u0438\u0435 \u043F\u043E\u0441\u0451\u043B\u043A\u0438
    \u0434\u0430\u0432\u043D\u043E \u0441\u043B\u0438\u043B\u0438\u0441\u044C \u0441
    \u043F\u043E\u0440\u0442\u043E\u043C, \u043D\u043E \u0438\u0445
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430
    \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u0445 \u0433\u0440\u0443\u0437\u043E\u0432\u044B\u0445
    \u043B\u0438\u043D\u0438\u0439."
