  displayName: "\u041F\u0443\u0441\u0442\u043E\u0439 \u0413\u0435\u043D\u043E\u043C"
  description: "\u041D\u0430
    \u043F\u043E\u0434\u043B\u0451\u0442\u0435 \u0432\u0437\u0433\u043B\u044F\u0434
    \u0446\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F \u0437\u0430 \u043A\u0440\u0430\u044F
    \u0434\u0440\u0435\u0432\u043D\u0438\u0445 \u043A\u0440\u0430\u0442\u0435\u0440\u043E\u0432,
    \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043C\u044B\u0435 \u0434\u0430\u0436\u0435 \u0432
    \u0441\u043B\u0430\u0431\u043E\u043C \u0441\u0432\u0435\u0442\u0435. \u0414\u0430\u0436\u0435
    \u0441\u0430\u043C\u044B\u0435 \u0447\u0451\u0442\u043A\u0438\u0435 \u0441\u043D\u0438\u043C\u043A\u0438
    \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435
    \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u0438, \u043A\u0430\u043A\u043E\u0439
    \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0440\u044F\u0434\u043E\u043C \u0441
    \u043E\u0431\u0436\u0438\u0442\u044B\u043C\u0438 \u043C\u0438\u0440\u0430\u043C\u0438."
