  id: planet_eventide_lab_science_01
  displayName: "\u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F
    \u0412\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u0417\u0430\u0440\u0438"
  description: "\u041D\u0430
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u044B
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435
    \u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u0441\u043E\u0435\u0434\u0438\u043D\u0451\u043D\u043D\u044B\u0435
    \u0443\u0437\u043A\u0438\u043C\u0438 \u0434\u043E\u0440\u043E\u0433\u0430\u043C\u0438 \u0438
    \u043B\u0438\u043D\u0438\u044F\u043C\u0438 \u0441\u0432\u044F\u0437\u0438. \u041D\u0430
    \u0441\u0442\u0430\u0440\u044B\u0445 \u0432\u044B\u0448\u043A\u0430\u0445 \u0434\u043E \u0441\u0438\u0445
    \u043F\u043E\u0440 \u0432\u0438\u0441\u044F\u0442 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0435
    \u0442\u0430\u0431\u043B\u0438\u0446\u044B, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0438 \u043F\u0435\u0440\u0432\u044B\u0435
    \u0430\u043D\u0442\u0435\u043D\u043D\u044B."
