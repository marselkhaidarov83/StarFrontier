  m_Name: mission_delivery_basic_01
  m_EditorClassIdentifier: Data::DeliveryMissionTemplateConfig
  id: mission_delivery_basic_01
  displayName: "\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0442\u043e\u0432\u0430\u0440\u0430"
  description: "\u041f\u0435\u0440\u0435\u0432\u043e\u0437\u043a\u0430 \u043f\u0430\u0440\u0442\u0438\u0438 \u0442\u043e\u0432\u0430\u0440\u0430 \u043c\u0435\u0436\u0434\u0443 \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u043c\u0438."
  icon: {fileID: 21300000, guid: f9fc68f840683439e99838efabb854fe, type: 3}
  missionType: 0
  titlePattern: "Доставка: {targetSystem} -> {targetPlanet}"
  descriptionPattern: "\u0414\u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0433\u0440\u0443\u0437 \u00ab{itemName}\u00bb \u0432 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435 {amount} \u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0443 {targetPlanet} \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 {targetSystem}. \u041e\u0431\u044a\u0451\u043c \u0433\u0440\u0443\u0437\u0430: {cargoVolume}. \u0421\u0434\u0430\u0439\u0442\u0435 \u0433\u0440\u0443\u0437 \u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0435 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043d\u0430\u0433\u0440\u0430\u0434\u0443. \u041f\u0440\u0438 \u043f\u043e\u0442\u0435\u0440\u0435 \u0433\u0440\u0443\u0437\u0430 \u0438\u043b\u0438 \u0437\u0430\u0445\u0432\u0430\u0442\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0432\u0440\u0430\u0433\u043e\u043c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u0440\u043e\u0432\u0430\u043b\u0438\u0442\u0441\u044f."
  outcomeTexts:
    ReadyToTurnIn: "\u0412\u044b \u043f\u0440\u0438\u0431\u044b\u043b\u0438 \u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0443 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f. \u0421\u0434\u0430\u0439\u0442\u0435 \u0433\u0440\u0443\u0437 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0443."
    Completed: "\u0413\u0440\u0443\u0437 \u043f\u0435\u0440\u0435\u0434\u0430\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u044e. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0430."
    Failed: "\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u0440\u043e\u0432\u0430\u043b\u0435\u043d\u0430. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Expired: "\u0421\u0440\u043e\u043a \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0438\u0441\u0442\u0451\u043a. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Cancelled: "\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u0430. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    MissionCargoLost: "\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u0440\u043e\u0432\u0430\u043b\u0435\u043d\u0430: \u0433\u0440\u0443\u0437 \u043f\u043e\u0442\u0435\u0440\u044f\u043d. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    SystemCaptured: "\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u0440\u043e\u0432\u0430\u043b\u0435\u043d\u0430: \u0441\u0438\u0441\u0442\u0435\u043c\u0430 {targetSystem} \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043d\u0430 \u0432\u0440\u0430\u0433\u043e\u043c. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
