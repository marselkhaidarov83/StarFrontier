  defenseTitlePattern: "\u0417\u0430\u0449\u0438\u0442\u0430: {targetSystem}"
  defenseDescriptionPattern: "\u041f\u043e\u043c\u043e\u0433\u0438\u0442\u0435 \u043e\u0442\u0440\u0430\u0437\u0438\u0442\u044c \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u0435 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 {targetSystem}. \u0414\u043b\u044f \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u043e\u0431\u0435\u0434\u0438\u0442\u044c \u0438 \u043b\u0438\u0447\u043d\u043e \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442\u044c \u0445\u043e\u0442\u044f \u0431\u044b \u043e\u0434\u0438\u043d \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u0440\u0430\u0431\u043b\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u0443\u0434\u0430\u0440\u043e\u043c. \u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044c \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0434\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0431\u043e\u044f. \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u0431\u0435\u0434\u044b \u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u043f\u043b\u0430\u043d\u0435\u0442\u0435 \u044d\u0442\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0434\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f."
  defenseOutcomeTexts:
    ReadyToTurnIn: "\u0417\u0430\u0449\u0438\u0442\u0430: \u0431\u043e\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d. \u041f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u043f\u043b\u0430\u043d\u0435\u0442\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b {targetSystem} \u0434\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f."
    Completed: "\u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0430."
    Failed: "\u0423\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0431\u043e\u044e \u043d\u0435 \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u043d\u043e. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Expired: "\u041f\u0440\u0430\u0432\u043e \u043d\u0430 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0438\u0441\u0442\u0435\u043a\u043b\u043e. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Cancelled: "\u0417\u0430\u0434\u0430\u043d\u0438\u0435 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u043e. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    MissionCargoLost: ""
    SystemCaptured: "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043d\u0430 \u0432\u0440\u0430\u0433\u043e\u043c. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    BattleLostOrLeft: "\u0411\u043e\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d \u0431\u0435\u0437 \u043d\u0430\u0433\u0440\u0430\u0434\u044b: \u043f\u043e\u0431\u0435\u0434\u0430 \u0438 \u043b\u0438\u0447\u043d\u043e\u0435 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u0438\u0435 \u0432\u0440\u0430\u0433\u0430 \u043d\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u044b."
    LeftBeforeVictory: "\u0412\u044b \u043f\u043e\u043a\u0438\u043d\u0443\u043b\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0434\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0431\u043e\u044f. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    BattleDefeated: "\u0411\u043e\u0439 \u043f\u0440\u043e\u0438\u0433\u0440\u0430\u043d. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    NextInvasionStarted: "\u041d\u0430\u0447\u0430\u043b\u043e\u0441\u044c \u043d\u043e\u0432\u043e\u0435 \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u0435. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0439 \u0431\u043e\u0439 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430."
    RouteObjectiveUnavailable: ""
  liberationTitlePattern: "\u041e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u0435: {targetSystem}"
  liberationDescriptionPattern: "\u041f\u0440\u0438\u043c\u0438\u0442\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b {targetSystem}. \u0414\u043b\u044f \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u043e\u0431\u0435\u0434\u0438\u0442\u044c \u0438 \u043b\u0438\u0447\u043d\u043e \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442\u044c \u0445\u043e\u0442\u044f \u0431\u044b \u043e\u0434\u0438\u043d \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u0440\u0430\u0431\u043b\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u0443\u0434\u0430\u0440\u043e\u043c. \u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044c \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0434\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0431\u043e\u044f. \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u0431\u0435\u0434\u044b \u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u043f\u043b\u0430\u043d\u0435\u0442\u0435 \u044d\u0442\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0434\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f."
  liberationOutcomeTexts:
    ReadyToTurnIn: "\u041e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u0435: \u0431\u043e\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d. \u041f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u043f\u043b\u0430\u043d\u0435\u0442\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b {targetSystem} \u0434\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f."
    Completed: "\u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0430."
    Failed: "\u0423\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0431\u043e\u044e \u043d\u0435 \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u043d\u043e. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Expired: "\u041f\u0440\u0430\u0432\u043e \u043d\u0430 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0438\u0441\u0442\u0435\u043a\u043b\u043e. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Cancelled: "\u0417\u0430\u0434\u0430\u043d\u0438\u0435 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u043e. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    MissionCargoLost: ""
    SystemCaptured: "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043d\u0430 \u0432\u0440\u0430\u0433\u043e\u043c. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    BattleLostOrLeft: "\u0411\u043e\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d \u0431\u0435\u0437 \u043d\u0430\u0433\u0440\u0430\u0434\u044b: \u043f\u043e\u0431\u0435\u0434\u0430 \u0438 \u043b\u0438\u0447\u043d\u043e\u0435 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u0438\u0435 \u0432\u0440\u0430\u0433\u0430 \u043d\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u044b."
    LeftBeforeVictory: "\u0412\u044b \u043f\u043e\u043a\u0438\u043d\u0443\u043b\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0434\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0431\u043e\u044f. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    BattleDefeated: "\u0411\u043e\u0439 \u043f\u0440\u043e\u0438\u0433\u0440\u0430\u043d. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    NextInvasionStarted: "\u041d\u0430\u0447\u0430\u043b\u043e\u0441\u044c \u043d\u043e\u0432\u043e\u0435 \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u0435. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0439 \u0431\u043e\u0439 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430."
    RouteObjectiveUnavailable: ""
