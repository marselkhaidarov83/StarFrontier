  id: mission_recon_jump_point_01
  displayName: "\u0420\u0430\u0437\u0432\u0435\u0434\u043a\u0430 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b"
  description: "\u0420\u0430\u0437\u0432\u0435\u0434\u043a\u0430 \u0441 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c \u043a \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0443."
  icon: {fileID: 21300000, guid: bdb01c0ee9bc641ab9ecea6c6da227d1, type: 3}
  missionType: 2
  titlePattern: "\u0420\u0430\u0437\u0432\u0435\u0434\u043a\u0430: {targetSystem}"
  descriptionPattern: "\u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435\u0441\u044c \u0432\u043e \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 {targetSystem}. \u0420\u0430\u0437\u0432\u0435\u0434\u0430\u0439\u0442\u0435 {enemyCount} \u0440\u0430\u0437\u043d\u044b\u0445 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439, \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0432\u0448\u0438\u0441\u044c \u043a \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u043d\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 {scanDistance}. \u0412\u0435\u0440\u043d\u0438\u0442\u0435\u0441\u044c \u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0443 {sourcePlanet} \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 {sourceSystem} \u0438 \u0441\u0434\u0430\u0439\u0442\u0435 \u043e\u0442\u0447\u0451\u0442."
  outcomeTexts:
    ReadyToTurnIn: "\u0414\u0430\u043d\u043d\u044b\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u044b. \u041f\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435 \u043e\u0442\u0447\u0451\u0442 \u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0435 {sourcePlanet} \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0443."
    Completed: "\u0420\u0430\u0437\u0432\u0435\u0434\u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u0434\u0430\u043d\u044b. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0430."
    Failed: "\u0420\u0430\u0437\u0432\u0435\u0434\u043a\u0430 \u043f\u0440\u043e\u0432\u0430\u043b\u0435\u043d\u0430. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Expired: "\u0421\u0440\u043e\u043a \u0440\u0430\u0437\u0432\u0435\u0434\u043a\u0438 \u0438\u0441\u0442\u0451\u043a. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Cancelled: "\u0420\u0430\u0437\u0432\u0435\u0434\u043a\u0430 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u0430. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
