  id: mission_route_improve_01
  displayName: "mission_route_improve_01"
  description: ""
  icon: {fileID: 0}
  titlePattern: "\u0423\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430: {sourceSystem} \u2014 {targetSystem}"
  descriptionPattern: "\u041f\u0440\u043e\u0439\u0434\u0438\u0442\u0435 \u0438\u0437 \u0441\u0438\u0441\u0442\u0435\u043c\u044b {sourceSystem} \u0432 \u0441\u043e\u044e\u0437\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 {targetSystem} \u0434\u0432\u0443\u043c\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u0430\u043c\u0438: \u043f\u043e \u043f\u0440\u044f\u043c\u043e\u043c\u0443 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0443 \u0438 \u043f\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u043c\u0443 \u043f\u0443\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b. \u0417\u0430\u0442\u0435\u043c \u0432\u0435\u0440\u043d\u0438\u0442\u0435\u0441\u044c \u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0443 {sourcePlanet}. \u041f\u0440\u0438 \u0441\u0434\u0430\u0447\u0435 \u043e\u0442\u0447\u0451\u0442\u0430 \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0438 \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u0435 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043f\u0440\u044f\u043c\u043e\u0433\u043e \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043d\u0430 \u043e\u0434\u0438\u043d."
  outcomeTexts:
    ReadyToTurnIn: "\u041e\u0431\u0430 \u043f\u0443\u0442\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u044b. \u0421\u0434\u0430\u0439\u0442\u0435 \u043e\u0442\u0447\u0451\u0442 \u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0435 {sourcePlanet}, \u0447\u0442\u043e\u0431\u044b \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u043f\u0440\u044f\u043c\u043e\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043d\u0430\u0433\u0440\u0430\u0434\u0443."
    Completed: "\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043f\u0440\u044f\u043c\u043e\u0433\u043e \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043f\u043e\u0432\u044b\u0448\u0435\u043d \u043d\u0430 \u043e\u0434\u0438\u043d. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0430."
    Failed: "\u041f\u043e\u0438\u0441\u043a \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043f\u0440\u043e\u0432\u0430\u043b\u0435\u043d. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Expired: "\u0421\u0440\u043e\u043a \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u0438\u0441\u0442\u0451\u043a. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    Cancelled: "\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u043e. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
    MissionCargoLost: ""
    SystemCaptured: ""
    BattleLostOrLeft: ""
    LeftBeforeVictory: ""
    BattleDefeated: ""
    NextInvasionStarted: ""
    RouteObjectiveUnavailable: "\u0417\u0430\u0434\u0430\u043d\u0438\u0435 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u043e: \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u0435\u043c\u044b\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u043c. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
