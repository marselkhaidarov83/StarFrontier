  - {fileID: 21300000, guid: 0d6da5355339d4183a568af924d000e8, type: 3}
  - {fileID: 21300000, guid: 3fbc0db29ee324ffe9c5d35dd4478a94, type: 3}
  - {fileID: 21300000, guid: ca48eb240a5ca4445b611a4331d4444d, type: 3}
  - {fileID: 21300000, guid: 608d7747ea7b24497baa9bd6c051aed3, type: 3}
  systemTravelImages:
  - {fileID: 21300000, guid: c8459b022fdd64942a41d4c0fcfdccf5, type: 3}
  - {fileID: 21300000, guid: 5568d2879957f451c806b725600c60fc, type: 3}
  - {fileID: 21300000, guid: ac584c438e8fc4e61b1c9283b24ec080, type: 3}
  - {fileID: 21300000, guid: 9247b284ace4941ca96ed6c38a385903, type: 3}
  - {fileID: 21300000, guid: 96d71f6434aa947c29c487d540db6b86, type: 3}
  progressSlider: {fileID: 1253510241}
  gameStartShowSeconds: 1
  systemTravelShowSeconds: 0.3
  maxWorkProgressBeforeMinimumTime: 0.92
  maxProgressLeadSeconds: 1.5
  progressSmoothSpeed: 1.5
  offlineRelocationMaxNpcsPerSlice: 250
  offlineRelocationNpcPercent: 100
  offlineRelocationMaxSliceMs: 8
  bottomText: {fileID: 1799283469}
  gameStartTexts:
  - "\u0417\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u043C \u0436\u0438\u0432\u0443\u044E
    \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0443. \u041E\u043D\u0430 \u0443\u0436\u0435
    \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0438\u0434, \u0447\u0442\u043E \u0432\u0441\u0451
    \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C."
  - "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B
    \u043C\u0435\u0436\u0434\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u043C\u0438.
    \u041E\u0434\u0438\u043D \u043D\u0430\u0432\u0438\u0433\u0430\u0442\u043E\u0440
    \u0441\u043F\u043E\u0440\u0438\u0442 \u0441 \u043A\u0430\u0440\u0442\u043E\u0439."
  - "\u0411\u0443\u0434\u0438\u043C \u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u0440\u044B\u043D\u043A\u0438
    \u0438 \u0442\u0435\u0445, \u043A\u0442\u043E \u043E\u0431\u0435\u0449\u0430\u043B
    \u043D\u0435 \u0441\u043F\u0430\u0442\u044C \u043D\u0430 \u0441\u043C\u0435\u043D\u0435."
  - "\u0421\u0447\u0438\u0442\u0430\u0435\u043C \u0442\u043E\u043F\u043B\u0438\u0432\u043E.
    \u041D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439, \u043A\u0443\u0434\u0430
    \u0434\u0435\u043B\u0430\u0441\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
    \u043A\u0430\u043D\u0438\u0441\u0442\u0440\u0430."
  - "\u041F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u043C \u043D\u043E\u0432\u043E\u0441\u0442\u0438
    \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0438. \u0425\u043E\u0440\u043E\u0448\u0438\u0435
    \u0442\u043E\u0436\u0435 \u0438\u0449\u0435\u043C, \u0447\u0435\u0441\u0442\u043D\u043E."
  - "\u041F\u0440\u043E\u0442\u0438\u0440\u0430\u0435\u043C \u0438\u043B\u043B\u044E\u043C\u0438\u043D\u0430\u0442\u043E\u0440
    \u043F\u0435\u0440\u0435\u0434 \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043A\u043E\u0441\u043C\u043E\u0441\u043E\u043C."
  - "\u0421\u0432\u0435\u0440\u044F\u0435\u043C \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
    \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E. \u0420\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0430."
  - "\u0413\u043E\u0442\u043E\u0432\u0438\u043C \u043A\u043E\u0440\u0430\u0431\u043B\u044C
    \u043A \u0432\u044B\u043B\u0435\u0442\u0443. \u041E\u043D \u043F\u043E\u0447\u0442\u0438
    \u043D\u0435 \u0432\u043E\u0440\u0447\u0438\u0442."
  - "\u041D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u043C \u0441\u043A\u0430\u043D\u0435\u0440\u044B.
    \u0410\u043D\u043E\u043C\u0430\u043B\u0438\u0438 \u0443\u0436\u0435 \u0434\u0435\u043B\u0430\u044E\u0442
    \u0432\u0438\u0434, \u0447\u0442\u043E \u0438\u0445 \u043D\u0435\u0442."
  - "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u043C frontier-\u0440\u0435\u0433\u0438\u043E\u043D.
    \u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u043E\u043D \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B."
  systemTravelTexts:
  - "\u041F\u0440\u043E\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442.
    \u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043F\u0443\u0442\u044C \u043E\u043F\u044F\u0442\u044C
    \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0433\u0435\u0440\u043E\u0438\u0447\u0435\u0441\u043A\u0438."
  - "\u0420\u0430\u0437\u0433\u043E\u043D\u044F\u0435\u043C \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C.
    \u0415\u0441\u043B\u0438 \u0447\u0442\u043E, \u044D\u0442\u043E \u0431\u044B\u043B
    \u043F\u043B\u0430\u043D."
  - "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u0442\u043E\u043F\u043B\u0438\u0432\u043E.
    \u041A\u0430\u043F\u0438\u0442\u0430\u043D \u0434\u0435\u043B\u0430\u0435\u0442
    \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0435 \u043B\u0438\u0446\u043E."
  - "\u0421\u043B\u0443\u0448\u0430\u0435\u043C \u043C\u0430\u044F\u043A\u0438 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u041E\u0434\u0438\u043D \u0437\u0432\u0443\u0447\u0438\u0442
    \u043A\u0430\u043A \u043F\u0440\u043E\u0441\u044C\u0431\u0430 \u043E \u043A\u043E\u0444\u0435."
  - "\u041E\u0431\u0445\u043E\u0434\u0438\u043C \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0435
    \u0443\u0447\u0430\u0441\u0442\u043A\u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430.
    \u041F\u043E\u0447\u0442\u0438 \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E."
  - "\u041F\u0435\u0440\u0435\u0434\u0430\u0451\u043C \u0441\u0442\u0430\u043D\u0446\u0438\u0438:
    \u043C\u044B \u0443\u0436\u0435 \u0432 \u043F\u0443\u0442\u0438, \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0439\u0442\u0435
    \u043A\u0440\u0430\u0441\u0438\u0432\u043E."
  - "\u0421\u043A\u0430\u043D\u0438\u0440\u0443\u0435\u043C \u0442\u043E\u0447\u043A\u0443
    \u0432\u044B\u0445\u043E\u0434\u0430. \u041A\u043E\u0441\u043C\u043E\u0441 \u043E\u0431\u0435\u0449\u0430\u0435\u0442
    \u0431\u044B\u0442\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
  - "\u0423\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u043C \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044E
    \u043D\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u0441\u0430\u043C\u044B\u0439
    \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442."
  - "\u0414\u0435\u0440\u0436\u0438\u043C \u043A\u0443\u0440\u0441 \u0447\u0435\u0440\u0435\u0437
    frontier. \u0412\u0438\u0434\u044B \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0435,
    \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u0430 \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u0435\u0442."
  - "\u0413\u043E\u0442\u043E\u0432\u0438\u043C\u0441\u044F \u043A \u0432\u0445\u043E\u0434\u0443
    \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0443. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
    \u043F\u0440\u0438\u0441\u0442\u0435\u0433\u043D\u0438\u0442\u0435 \u043C\u043E\u0434\u0443\u043B\u0438."
  textChangeSeconds: 1
